rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/members/$(request.auth.uid)).data.role == 'admin';
    }

    match /members/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'member';
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && (
          request.resource.data.familyId == resource.data.familyId
          || (
            request.resource.data.acceptedInvitationId is string
            && request.resource.data.acceptedInvitationId != ''
            && get(/databases/$(database)/documents/invitations/$(request.resource.data.acceptedInvitationId)).data.memberId == request.auth.uid
            && get(/databases/$(database)/documents/invitations/$(request.resource.data.acceptedInvitationId)).data.status == 'accepted'
            && get(/databases/$(database)/documents/invitations/$(request.resource.data.acceptedInvitationId)).data.familyId == request.resource.data.familyId
          )
        )
      );
      allow delete: if isAdmin();
    }

    match /invitations/{id} {
      allow create: if isAdmin()
        && request.resource.data.status == 'pending';
      allow read: if signedIn() &&
        (isAdmin() || resource.data.memberId == request.auth.uid);
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.memberId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.memberId == resource.data.memberId
        && request.resource.data.familyId == resource.data.familyId
        && request.resource.data.status in ['accepted', 'rejected']
      );
      allow delete: if isAdmin();
    }

    match /families/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /agencies/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
